<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recentsScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BF080C14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_apps_title"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/recentsRamStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/emptyRecentsText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/no_recent_apps"
            android:textColor="#80FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Cards Horizontal Scroll -->
        <HorizontalScrollView
            android:id="@+id/recentsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/recentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- Clear All Button placed below the apps row -->
        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/kill_all_tasks"
            android:textColor="@drawable/pill_text"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/pill_bg"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Press OK to switch to app • Press UP or Kill to terminate and free RAM"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_light" />
    </LinearLayout>
</FrameLayout>
