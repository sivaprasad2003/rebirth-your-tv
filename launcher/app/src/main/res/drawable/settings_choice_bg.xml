<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D10B981" />
            <corners android:radius="13dp" />
            <stroke android:width="2dp" android:color="#FF6EE7B7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E059669" />
            <corners android:radius="13dp" />
            <stroke android:width="1.5dp" android:color="#FF10B981" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A222C38" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
